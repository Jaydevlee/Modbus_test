@page "/dashboard"
@rendermode InteractiveServer
@inject DBRepository DbRepository
<PageTitle>Dashboard</PageTitle>
<h1>Dashboard</h1>

<table>
    <tr>
        <th>시간</th>
        <th>장비이름</th>
        <th>주소</th>
        <th>측정값</th>
        <th>측정값</th>
        <th>단위</th>
        <th>품질</th>
        <th>수집시간</th>
    </tr>
    @foreach(var items in @DataList){
        <tr>
            <td>@items.Time.ToLocalTime()</td>
            <td>@items.EquipId</td>
            <td>@items.Address</td>
            <td>@items.MetricName</td>
            <td>@items.MetricValue</td>
            <td>@items.Unit</td>
            <td>@items.Quality</td>
            <td>@items.CollectedAt</td>
        </tr>
    }
</table>

@code{
    private List<PlcDto> DataList = [];
    protected override async Task OnInitializedAsync(){
        DataList = await DbRepository.GetMetricDataAsync();
    }
}