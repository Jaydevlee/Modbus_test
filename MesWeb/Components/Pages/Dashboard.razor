@page "/dashboard"
@rendermode InteractiveServer
@inject DBRepository DbRepository
<PageTitle>Dashboard</PageTitle>
<MudText Typo="Typo.h4" Calss="mb-4">대시보드</MudText>

<MudTable Items="@DataList">
    <HeaderContent>
        <MudTh>시간</MudTh>
        <MudTh>장비이름</MudTh>
        <MudTh>주소</MudTh>
        <MudTh>측정데이터</MudTh>
        <MudTh>측정값</MudTh>
        <MudTh>단위</MudTh>
        <MudTh>품질</MudTh>
        <MudTh>수집시간</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Time.ToLocalTime()</MudTd>
        <MudTd>@context.EquipId</MudTd>
        <MudTd>@context.Address</MudTd>
        <MudTd>@context.MetricName</MudTd>
        <MudTd>@context.MetricValue</MudTd>
        <MudTd>@context.Unit</MudTd>
        <MudTd>@context.Quality</MudTd>
        <MudTd>@context.CollectedAt.ToLocalTime()</MudTd>
    </RowTemplate>
</MudTable>

@code{
    private List<PlcDto> DataList = [];
    protected override async Task OnInitializedAsync(){
        DataList = await DbRepository.GetMetricDataAsync();
    }
}