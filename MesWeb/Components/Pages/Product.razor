@page "/product"
@rendermode InteractiveServer
@inject ProductRepository productRepository
@inject ISnackbar snackbarService

@if(loadData == false) 
{
    <MudAlert Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@loadErrMsg</MudAlert>
}

<PageTitle>품목 관리</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">품목 관리</MudText>

<MudStack Row="true" Class="mb-4">
    <MudTextField @bind-Value="name" Label="품목명" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="recipeVer" Label="제작버전" Variant="Variant.Outlined" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InsertProduct">등록</MudButton>
</MudStack>

<MudDataGrid Items="@datalist" SortMode="SortMode.Multiple" Filterable="true">
    <Columns>
        <PropertyColumn Property="x => x.ProductId" Title="품목번호" />
        <PropertyColumn Property="x => x.Name" Title="품목명" />
        <PropertyColumn Property="x => x.RecipeVersion" Title="제조법 번호" />
        <TemplateColumn Title="활성화 여부" SortBy="x => x.IsActive">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code{
    private string name = string.Empty;
    private string recipeVer = string.Empty;
    private bool IsActive = true;
    private bool? dataStored;
    private bool? loadData;
    private string? loadErrMsg;
    private string? insertErrMsg;
    private  List<ProductDto> datalist = [];

    protected override async Task OnInitializedAsync(){
        await LoadDataAsync();
    }

    private async Task InsertProduct(){
        ProductDto productDto = new ProductDto{
                                                Name = name,
                                                RecipeVersion = recipeVer,
                                                IsActive = IsActive                
                                            };
        try
        {
            int result = await productRepository.InsertProductAsync(productDto);
            dataStored = result > 0;
            await LoadDataAsync();
            ShowInsertSnakbar();
        }
        catch (Exception ex)
        {
            dataStored = false;
            insertErrMsg = ex.Message;
            ShowInsertSnakbar();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            datalist = await productRepository.GetProductDataAsync();
            loadData = true;
        } 
        catch (Exception ex)
        {
            loadData = false;
            loadErrMsg = ex.Message;
        }
    }

    private void ShowInsertSnakbar(){
        if(dataStored == true) snackbarService.Add("품목이 저장되었습니다.", Severity.Info, (options) =>
        {
            options.CloseAfterNavigation = true;
        });
        else snackbarService.Add($"품목 저장을 실패했습니다: {insertErrMsg}", Severity.Error);
    }
}
